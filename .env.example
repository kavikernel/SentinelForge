# PORT: Server port (must be 3000 in AI Studio preview)
PORT=3000

# NODE_ENV: development or production
NODE_ENV=development

# SESSION_SECRET: Optional HMAC signing secret for local demo session tokens.
# If omitted, a secure random secret is generated per server boot.
SESSION_SECRET=

# DATA_DIR: Directory for local JSON persistence store (defaults to ./data)
DATA_DIR=./data

# GEMINI_API_KEY: Optional. Not required; SentinelForge uses deterministic local ML and rules by default.
GEMINI_API_KEY=

# APP_URL: Hosted URL injected automatically by runtime
APP_URL=http://localhost:3000
